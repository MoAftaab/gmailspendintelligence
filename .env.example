PORT=3000
NODE_ENV=development
SESSION_SECRET=replace-with-a-long-random-value

# Create an OAuth 2.0 Web application client in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Optional: restrict ingestion to a shorter period while developing.
GMAIL_LOOKBACK_YEARS=2

# Optional AI enrichment. Keep this server-side; never expose it in frontend code.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://codecraftapi.com/v1
OPENAI_MODEL=gpt-5.6-luna
OPENAI_MAX_EMAILS=10
GMAIL_MAX_MESSAGES=25
